{"schemaVersion":"native-flow-v1","source":"// 岩：钟离 / 班尼特 / 娜维娅 / 香菱。一枪后按本次附魔实际剩余时间选择短打，不预设两枪满层。\n// 未知被动条件只走普通短打；静态两次充能不当作当前还有两次可用。E 确认不等于结晶层数/命中。\n// 班尼特给香菱的接球关系显式声明，只有明确缺能且非 CD 时执行供能。\nstrategy(loop=battle)\ntiming(离线护盾,cd=12,duration=20)\ncall(开场,once=battle,required)\n钟离 e(hold,wait,timing=离线护盾,record=护盾,maintain=护盾,watch=护盾,watch-mode=call,watch-target=补盾,before=4,required)\n班尼特 q(if=q-ready(班尼特))\ncall(供能,if=q-energy-low(香菱) && !q-cd(香菱) && e-ready(班尼特))\n香菱 e(fast), q(if=q-ready(香菱))\n娜维娅 q(if=q-ready(娜维娅))\ncall(一枪短打,if=e-ready(娜维娅))\n娜维娅 attack(0.4,keep=护盾), check\n\nsegment(开场,define,record=开场完成) {\n    钟离 e(hold,wait,timing=离线护盾,required,record=护盾)\n}\nsegment(补盾,define) {\n    钟离 e(hold,wait,timing=离线护盾,required,record=护盾,maintain=护盾)\n}\n\nsegment(供能,define) {\n    班尼特 e(fast,required,feed=香菱)\n}\nsegment(一枪短打,define,atomic,requires=record-active(护盾)) {\n    娜维娅 e(hold,fast,required,record=岩附魔,keep=护盾)\n    branch(if=record-remaining(岩附魔)>3,then=附魔长打,else=附魔短选,unknown=普通短打,required)\n}\nsegment(附魔长打,define) {\n    娜维娅 attack(1.4,keep=岩附魔,required)\n}\nsegment(附魔短选,define) {\n    branch(if=record-remaining(岩附魔)>1.8,then=附魔短打,else=普通短打,unknown=普通短打,required)\n}\nsegment(附魔短打,define) {\n    娜维娅 attack(0.5,keep=岩附魔,required)\n}\nsegment(普通短打,define) {\n    娜维娅 attack(0.4,keep=护盾)\n}\n","loop":true,"root":[{"id":"n3","kind":"call","character":"","line":6,"column":1,"start":194,"end":223,"args":["开场"],"options":{"once":"battle","required":"true"}},{"id":"n4","kind":"skill","character":"zhongli","line":7,"column":1,"start":224,"end":332,"args":[],"options":{"hold":"true","wait":"true","timing":"离线护盾","record":"护盾","maintain":"护盾","watch":"护盾","watch-mode":"call","watch-target":"补盾","before":"4","required":"true"}},{"id":"n5","kind":"burst","character":"bennett","line":8,"column":1,"start":333,"end":355,"args":[],"options":{"if":"q-ready(班尼特)"},"condition":{"op":"call","name":"q-ready","argument":"bennett"}},{"id":"n6","kind":"call","character":"bennett","line