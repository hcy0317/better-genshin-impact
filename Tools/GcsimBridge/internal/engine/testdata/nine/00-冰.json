{"schemaVersion":"native-flow-v1","source":"// 冰：钟离 / 珊瑚宫心海 / 神里绫华 / 芙宁娜。水母仅在有效窗口及已核验被动条件下由 Q 刷新。\n// 错过窗口或缺少刷新能力走 E 重建；E 未好保留空档，不创建虚假水母。\n// 绫华先冲刺与站位准备，再用本次确认 Q 解锁短输出；位置准备不等于命中/冻结识别。\nstrategy(loop=battle)\ntiming(离线护盾,cd=12,duration=20)\ncall(开场,once=battle,required)\n钟离 e(hold,wait,timing=离线护盾,record=护盾,maintain=护盾,watch=护盾,watch-mode=call,watch-target=补盾,before=4,required)\ncall(心海治疗,if=low-hp(珊瑚宫心海) || low-hp(神里绫华) || low-hp(芙宁娜))\n芙宁娜 e(fast,record=沙龙,maintain=沙龙,before=3), q(if=q-ready(芙宁娜))\ncall(水母续期,if=record-active(水母) && record-remaining(水母)<6 && q-ready(珊瑚宫心海))\n珊瑚宫心海 e(fast,record=水母,maintain=水母,before=3)\ncall(绫华自充,if=q-energy-low(神里绫华) && !q-cd(神里绫华) && e-ready(神里绫华))\nbranch(if=q-ready(神里绫华),then=绫华爆发,else=普通短轴,unknown=普通短轴)\n神里绫华 check\n\nsegment(开场,define,record=开场完成) {\n    钟离 e(hold,wait,timing=离线护盾,required,record=护盾)\n}\nsegment(补盾,define) {\n    钟离 e(hold,wait,timing=离线护盾,required,record=护盾,maintain=护盾)\n}\n\nsegment(水母续期,define,onfail=重建水母) {\n    珊瑚宫心海 q(required,keep=水母,refresh=水母,record=仪来羽衣)\n}\nsegment(重建水母,define) {\n    珊瑚宫心海 e(fast,required,record=水母,maintain=水母)\n}\nsegment(心海治疗,define) {\n    珊瑚宫心海 q(required,record=仪来羽衣)\n    珊瑚宫心海 attack(1,keep=仪来羽衣,required), attack(1,keep=仪来羽衣,required)\n}\nsegment(绫华自充,define) {\n    神里绫华 e(fast,required,feed=神里绫华)\n}\nsegment(普通短轴,define) {\n    神里绫华 attack(0.5,keep=护盾)\n}\nsegment(绫华爆发,define,atomic,timeout=8,onfail=普通短轴,requires=record-active(护盾),record=本次霜灭完成) {\n    神里绫华 dash(0.2), wait(0.15), q(required,keep=护盾,record=霜灭), attack(1,keep=护盾)\n}\n","loop":true,"root":[{"id":"n3","kind":"call","character":"","line":6,"column":1,"start":191,"end":220,"args":["开场"],"options":{"once":"battle","required":"true"}},{"id":"n4","kind":"skill","character":"zhongli","line":7,"column":1,"start":221,"end":329,"args":[],"options":{"hold":"true","wait":"true","timing":"离线护盾","record":"护盾","maintain":"护盾","watch":"护盾","watch-mode":"call","watch-target":"补盾","before":"4","required":"true"}},{"id":"n5","kin