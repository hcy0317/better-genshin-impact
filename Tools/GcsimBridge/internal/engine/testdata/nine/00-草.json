{"schemaVersion":"native-flow-v1","source":"// 草：钟离 / 芙宁娜 / 纳西妲 / 久岐忍。草标记、沙龙、雷环和护盾分别计时。\n// 雷环可能有空档，过期不假装续上；已知低血先尝试雷环照护，Unknown 不反向授权。\n// 芙宁娜增伤不作为超绽放加成依据；治疗前台不声称等同全队群疗。\nstrategy(loop=battle)\ntiming(离线护盾,cd=12,duration=20)\ncall(开场,once=battle,required)\n钟离 e(hold,wait,timing=离线护盾,record=护盾,maintain=护盾,watch=护盾,watch-mode=call,watch-target=补盾,before=4,required)\ncall(雷环照护,if=low-hp(久岐忍) || low-hp(纳西妲) || low-hp(芙宁娜))\n久岐忍 e(fast,record=雷环,maintain=雷环,before=2)\n纳西妲 e(hold,fast,record=草标记,maintain=草标记,before=3), q(if=q-ready(纳西妲))\n芙宁娜 e(fast,record=沙龙,maintain=沙龙,before=3), q(if=q-ready(芙宁娜))\nbranch(if=record-active(雷环),then=环内短轴,else=空档短轴,unknown=空档短轴)\n纳西妲 check\n\nsegment(开场,define,record=开场完成) {\n    钟离 e(hold,wait,timing=离线护盾,required,record=护盾)\n}\nsegment(补盾,define) {\n    钟离 e(hold,wait,timing=离线护盾,required,record=护盾,maintain=护盾)\n}\n\nsegment(雷环照护,define) {\n    久岐忍 e(fast,record=雷环,maintain=雷环)\n    纳西妲 attack(0.5,keep=护盾)\n}\nsegment(环内短轴,define,atomic,requires=record-active(护盾)) {\n    纳西妲 attack(1,keep=雷环,required), charge(0.3,keep=雷环,required)\n}\nsegment(空档短轴,define) {\n    纳西妲 attack(0.5,keep=护盾)\n}\n","loop":true,"root":[{"id":"n3","kind":"call","character":"","line":6,"column":1,"start":177,"end":206,"args":["开场"],"options":{"once":"battle","required":"true"}},{"id":"n4","kind":"skill","character":"zhongli","line":7,"column":1,"start":207,"end":315,"args":[],"options":{"hold":"true","wait":"true","timing":"离线护盾","record":"护盾","maintain":"护盾","watch":"护盾","watch-mode":"call","watch-target":"补盾","before":"4","required":"true"}},{"id":"n5","kind":"call","character":"zhongli","line":8,"column":1,"start":316,"end":371,"args":["雷环照护"],"options":{"if":"low-hp(久岐忍) || low-hp(纳西妲) || low-hp(芙宁娜)"},"condition":{"op":"or","left":{"op":"or","left":{"op":"call","name":"low-hp","argument":"kukishinobu"},"right":{"op":"call","name":"low-hp","argument":"nahida"}},"right":{"op":"call","name":"low-hp","argument":"furina"}}},{"id":"n6","kind":"skill","character":"